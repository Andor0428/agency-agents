# Groq API — Whisper Large v3 Turbo transcription
GROQ_API_KEY=

# OpenAI API — GPT-4o-mini structured parsing
OPENAI_API_KEY=

# Together AI — Nemotron 3.5 ASR (British English en-GB)
# https://huggingface.co/nvidia/nemotron-3.5-asr-streaming-0.6b
TOGETHER_API_KEY=

# Google Sheets (default spreadsheet sync)
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Inventory

# Microsoft Graph Excel (optional adapter)
MICROSOFT_GRAPH_CLIENT_ID=

# App defaults
CONFIDENCE_THRESHOLD=80

# EAS Build (optional)
EAS_PROJECT_ID=

# Support admin API (M11) — URL reachable from your phone on the same network
# Example: http://192.168.1.10:3001
SUPPORT_API_URL=

# Google OAuth (M14) — Desktop app client (NOT Web application — stocktake:// needs Desktop type)
# Google Cloud Console → Credentials → Create OAuth client → Desktop app
# Add authorized redirect URI: stocktake://
GOOGLE_OAUTH_CLIENT_ID=
# Same Desktop app credentials on the API (for server-side token refresh):
# GOOGLE_OAUTH_CLIENT_ID=   (in stock-take-api/.env)
# GOOGLE_OAUTH_CLIENT_SECRET=
